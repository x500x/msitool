  <string id="SetupTitle">[ProductName] 安装程序</string>

  <string id="WelcomeTitle">欢迎使用 [ProductName] 安装向导</string>
  <string id="WelcomeDescription">安装向导将在您的计算机上安装 [ProductName] [ProductVersion]。单击“下一步”继续，或单击“取消”退出。</string>

  <string id="LicenseTitle">最终用户许可协议</string>
