  <string id="UserExitTitle">[ProductName] 安装向导被中断</string>
  <string id="UserExitText">您的系统尚未修改。如需稍后安装此程序，请重新运行安装程序。</string>

  <string id="FatalTitle">[ProductName] 安装向导提前结束</string>
