  <string id="InstallDirFolderLabel">将 [ProductName] 安装到：</string>
  <string id="Change">更改(&amp;C)...</string>

  <string id="VerifyTitle">准备安装 [ProductName]</string>
  <string id="VerifyText">单击“安装”开始安装。单击“上一步”查看或更改安装设置，或单击“取消”退出向导。</string>
  <string id="Install">安装(&amp;I)</string>

  <string id="Back">上一步(&amp;B)</string>
  <string id="Next">下一步(&amp;N)</string>
  <string id="Cancel">取消</string>
